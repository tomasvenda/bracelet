/ {
	/* Simple always-on regulator model for 1V8_SW that feeds IOVDD */
	reg_1v8_sw: reg_1v8_sw {
		compatible = "regulator-fixed";
		regulator-name = "1V8_SW";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};
};

&pinctrl {
	uart0_default: uart0_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 0)>,
				<NRF_PSEL(UART_RX, 0, 1)>;
		};
	};

	uart0_sleep: uart0_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 0)>,
				<NRF_PSEL(UART_RX, 0, 1)>;
			low-power-enable;
		};
	};

	spi3_default: spi3_default {
		group1 {
			/* SPI SCK/MOSI/MISO as per your mapping */
			psels = <NRF_PSEL(SPIM_SCK, 0, 13)>,
				<NRF_PSEL(SPIM_MOSI, 0, 14)>,
				<NRF_PSEL(SPIM_MISO, 0, 15)>;
		};
	};

	spi3_sleep: spi3_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 13)>,
				<NRF_PSEL(SPIM_MOSI, 0, 14)>,
				<NRF_PSEL(SPIM_MISO, 0, 15)>;
			low-power-enable;
		};
	};
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-1 = <&uart0_sleep>;
	pinctrl-names = "default", "sleep";
};

&spi3 {
	status = "okay";
	pinctrl-0 = <&spi3_default>;
	pinctrl-1 = <&spi3_sleep>;
	pinctrl-names = "default", "sleep";

	/* CS0 on P0.12 for nRF70, CS1 unused for now */
	cs-gpios = <&gpio0 12 GPIO_ACTIVE_LOW>;

	nrf70: wifi@0 {
        compatible = "nordic,nrf7002-spi";
        reg = <0>;
        status = "okay";

        spi-max-frequency = <2000000>;
        duplex = <0>;
        frame-format = <0>;
        spi-interframe-delay-ns = <0>;

        bucken-gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>;
        host-irq-gpios = <&gpio0 16 GPIO_ACTIVE_HIGH>;

        iovdd-regulator = <&reg_1v8_sw>;
        iovdd-power-up-delay-ms = <5>;

        wifi-max-tx-pwr-2g-dsss = <16>;
        wifi-max-tx-pwr-2g-mcs0 = <16>;
        wifi-max-tx-pwr-2g-mcs7 = <15>;
        wifi-max-tx-pwr-5g-low-mcs0 = <14>;
        wifi-max-tx-pwr-5g-low-mcs7 = <13>;
        wifi-max-tx-pwr-5g-mid-mcs0 = <14>;
        wifi-max-tx-pwr-5g-mid-mcs7 = <13>;
        wifi-max-tx-pwr-5g-high-mcs0 = <14>;
        wifi-max-tx-pwr-5g-high-mcs7 = <13>;

        wlan0: wlan0 {
            compatible = "nordic,wlan";
        };
    };
};

 / {
	chosen {
		zephyr,wifi = &wlan0;
	};
};
